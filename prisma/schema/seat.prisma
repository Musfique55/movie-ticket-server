model ShowSeat {
    id            String  @id @unique @default(cuid())
    seatId        String
    showTimeId    String
    reservationId String?

    status ShowSeatStatus @default(AVAILABLE)

    createdAt DateTime @default(now())
    updatedAt DateTime @updatedAt

    seat        Seat         @relation(fields: [seatId], references: [id], onDelete: Cascade)
    showTime    ShowTime     @relation(fields: [showTimeId], references: [id], onDelete: Cascade)
    reservation Reservation? @relation(fields: [reservationId], references: [id], onDelete: Cascade)

    @@index([showTimeId, status, reservationId])
    @@index([seatId])
    @@map("showSeat")
}

model Seat {
    id             String     @id @unique @default(cuid())
    name           String
    rowPosition    String
    columnPosition Int
    basePrice      Float
    type           SeatType
    status         SeatStatus @default(AVAILABLE)

    theatreId String
    theatre   Theatre @relation(fields: [theatreId], references: [id], onDelete: Cascade)

    hallId String
    hall   Hall   @relation(fields: [hallId], references: [id], onDelete: Cascade)

    createdAt DateTime   @default(now())
    updatedAt DateTime   @updatedAt
    showSeats ShowSeat[]

    @@index([type, theatreId, hallId])
    @@map("seat")
}

enum SeatStatus {
    AVAILABLE
    UNAVAILABLE
}

enum SeatType {
    STANDARD
    PREMIUM
    VIP
}

enum ShowSeatStatus {
    LOCKED
    AVAILABLE
    BOOKED
}
