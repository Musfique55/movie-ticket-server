generator client {
  provider = "prisma-client"
  output   = "../src/generated/prisma"
}

datasource db {
  provider = "postgresql"
}

enum ShowSeatStatus {
  LOCKED
  AVAILABLE
  BOOKED
}

enum SeatStatus {
  AVAILABLE
  UNAVAILABLE
}

enum ReservationStatus {
  CONFIRMED
  CANCELLED
  PENDING
}

enum PaymentStatus {
  PAID
  PENDING
  FAILED
}

enum Role {
  USER
  ADMIN
}

enum SeatType {
  STANDARD
  PREMIUM
  VIP
}

model User {
  id           String        @id @default(cuid())
  name         String        @db.VarChar(100)
  email        String        @unique @db.VarChar(100)
  password     String        @db.VarChar(255)
  phone        String        @db.VarChar(15)
  role         Role          @default(USER)
  createdAt    DateTime      @default(now())
  updatedAt    DateTime      @updatedAt
  reservations Reservation[]

  @@index([id, email])
  @@map("user")
}

model Seat {
  id        String     @id @default(cuid())
  row       String
  number    Int
  basePrice Float
  type      SeatType
  status    SeatStatus @default(AVAILABLE)

  createdAt DateTime   @default(now())
  updatedAt DateTime   @updatedAt
  showSeats ShowSeat[]

  @@index([id, type])
  @@map("seat")
}

model ShowSeat {
  id         String         @id @default(cuid())
  seatId     String
  showTimeId String
  status     ShowSeatStatus @default(AVAILABLE)

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  seat     Seat     @relation(fields: [seatId], references: [id])
  showTime ShowTime @relation(fields: [showTimeId], references: [id])
  tickets  Ticket[]

  @@index([id, seatId, showTimeId])
  @@map("showSeat")
}

model ShowTime {
  id        String   @id @default(cuid())
  movieId   String
  startTime DateTime
  endTime   DateTime
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  showSeats ShowSeat[]

  @@index([id, movieId, startTime, endTime])
  @@map("showTime")
}

model Reservation {
  id          String            @id @unique @default(cuid())
  userId      String
  user        User              @relation(fields: [userId], references: [id])
  status      ReservationStatus @default(PENDING)
  totalAmount Float
  discount    Float?
  expiresAt   DateTime?

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
  tickets   Ticket[]

  @@index([id, userId])
  @@map("reservation")
}

model Ticket {
  id            String @id @default(cuid())
  reservationId String
  showSeatId    String
  price         Float

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  reservation Reservation @relation(fields: [reservationId], references: [id])
  showSeat    ShowSeat    @relation(fields: [showSeatId], references: [id])

  @@index([id, reservationId, showSeatId])
  @@map("ticket")
}

model Payment {
  id            String  @id @default(cuid())
  userId        String
  name          String
  email         String
  amount        Float
  stripeEventId String? @unique
  transactionId String? @unique

  paymentGatewayData Json?
  invoiceUrl         String?

  status PaymentStatus @default(PENDING)

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([id, userId, email])
  @@map("payment")
}
